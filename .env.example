# VisionPilot Environment Configuration
# Copy to .env and fill in values

# Application
PYTHONPATH=/app/src
LOG_LEVEL=info
PORT=8000

# AWS (for production deployment)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_UPLOAD_BUCKET=visionpilot-uploads
S3_RESULTS_BUCKET=visionpilot-results

# Optional: Database (for persistent storage)
# DATABASE_URL=postgresql://user:pass@host:5432/visionpilot

# Optional: Authentication (for production)
# AUTH_ENABLED=false
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=

# Optional: Monitoring
# PROMETHEUS_ENABLED=false
# XRAY_ENABLED=false